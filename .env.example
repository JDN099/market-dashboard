# Local PostgreSQL fallback.
DB_NAME=market_dashboard
DB_USER=postgres
DB_PASSWORD=local_password_here
DB_HOST=localhost
DB_PORT=5432
DB_CONNECT_TIMEOUT=10
DB_SSLMODE=prefer

# Hosted PostgreSQL connection string
DATABASE_URL=

# Server-side news provider settings.
MARKETAUX_API_KEY=replace_with_marketaux_key
MARKETAUX_DOMAINS=apnews.com,cnbc.com,finance.yahoo.com,marketwatch.com,reuters.com

# Server-side market-data provider.
TWELVE_DATA_API_KEY=replace_with_twelve_data_key

# Application and deployment behavior.
APP_ENV=development
FLASK_DEBUG=false
TRUST_PROXY_HEADERS=false
VISITOR_COOKIE_SECURE=false
LOG_LEVEL=WARNING
